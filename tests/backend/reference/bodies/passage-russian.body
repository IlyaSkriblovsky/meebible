            <h2>Бытие 1:1–3</h2>
            <div><div class="par"><div class="verse" verse="1"><div class="verse-label">1</div>&#1042; &#1085;&#1072;&#1095;&#1072;&#1083;&#1077; &#1089;&#1086;&#1090;&#1074;&#1086;&#1088;&#1080;&#1083; &#1041;&#1086;&#1075; &#1085;&#1077;&#1073;&#1086; &#1080; &#1079;&#1077;&#1084;&#1083;&#1102;.</div> </div><div class="par"><div class="verse" verse="2"><div class="verse-label">2</div>&#1047;&#1077;&#1084;&#1083;&#1103; &#1078;&#1077; &#1073;&#1099;&#1083;&#1072; &#1073;&#1077;&#1079;&#1074;&#1080;&#1076;&#1085;&#1072; &#1080; &#1087;&#1091;&#1089;&#1090;&#1072;, &#1080; &#1090;&#1100;&#1084;&#1072; &#1085;&#1072;&#1076; &#1073;&#1077;&#1079;&#1076;&#1085;&#1086;&#1102;, &#1080; &#1044;&#1091;&#1093; &#1041;&#1086;&#1078;&#1080;&#1081; &#1085;&#1086;&#1089;&#1080;&#1083;&#1089;&#1103; &#1085;&#1072;&#1076; &#1074;&#1086;&#1076;&#1086;&#1102;.</div> </div><div class="par"><div class="verse" verse="3"><div class="verse-label">3</div>&#1048; &#1089;&#1082;&#1072;&#1079;&#1072;&#1083; &#1041;&#1086;&#1075;: &#1076;&#1072; &#1073;&#1091;&#1076;&#1077;&#1090; &#1089;&#1074;&#1077;&#1090;. &#1048; &#1089;&#1090;&#1072;&#1083; &#1089;&#1074;&#1077;&#1090;.</div> </div></div>
