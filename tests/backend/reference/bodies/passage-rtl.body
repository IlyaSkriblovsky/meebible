            <h2>تكوين 1:1–3</h2>
            <div><div class="par"><div class="verse" verse="1"><div class="verse-label">1</div>&#1601;&#1616;&#1610; &#1575;&#1604;&#1618;&#1576;&#1614;&#1583;&#1618;&#1569;&#1616; &#1582;&#1614;&#1604;&#1614;&#1602;&#1614; &#1575;&#1604;&#1604;&#1607;&#1615; &#1575;&#1604;&#1587;&#1617;&#1614;&#1605;&#1614;&#1575;&#1608;&#1614;&#1575;&#1578;&#1616; &#1608;&#1614;&#1575;&#1604;&#1575;&#1585;&#1618;&#1590;&#1614;.</div> </div><div class="par"><div class="verse" verse="2"><div class="verse-label">2</div>&#1608;&#1614;&#1603;&#1614;&#1575;&#1606;&#1614;&#1578;&#1616; &#1575;&#1604;&#1575;&#1585;&#1618;&#1590;&#1615; &#1582;&#1614;&#1585;&#1616;&#1576;&#1614;&#1577;&#1611; &#1608;&#1614;&#1582;&#1614;&#1575;&#1604;&#1616;&#1610;&#1614;&#1577;&#1611; &#1608;&#1614;&#1593;&#1614;&#1604;&#1614;&#1609; &#1608;&#1614;&#1580;&#1618;&#1607;&#1616; &#1575;&#1604;&#1618;&#1594;&#1614;&#1605;&#1618;&#1585;&#1616; &#1592;&#1615;&#1604;&#1618;&#1605;&#1614;&#1577;&#1612; &#1608;&#1614;&#1585;&#1615;&#1608;&#1581;&#1615; &#1575;&#1604;&#1604;&#1607;&#1616; &#1610;&#1614;&#1585;&#1616;&#1601;&#1617;&#1615; &#1593;&#1614;&#1604;&#1614;&#1609; &#1608;&#1614;&#1580;&#1618;&#1607;&#1616; &#1575;&#1604;&#1618;&#1605;&#1616;&#1610;&#1614;&#1575;&#1607;&#1616;.</div> </div><div class="par"><div class="verse" verse="3"><div class="verse-label">3</div>&#1608;&#1614;&#1602;&#1614;&#1575;&#1604;&#1614; &#1575;&#1604;&#1604;&#1607;&#1615;: &laquo;&#1604;&#1616;&#1610;&#1614;&#1603;&#1615;&#1606;&#1618; &#1606;&#1615;&#1608;&#1585;&#1612;&raquo; &#1601;&#1614;&#1603;&#1614;&#1575;&#1606;&#1614; &#1606;&#1615;&#1608;&#1585;&#1612;.</div> </div></div>
